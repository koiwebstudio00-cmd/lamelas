# Backend propio (back-lamelas). Sin barra final.
VITE_API_URL=http://localhost:3001
# API key del módulo /export: la crea un admin desde el panel.
# Es de solo lectura y viaja en el bundle; se revoca desde el panel.
VITE_API_KEY=
# Slug del tenant. Solo hace falta si no es "lamelas".
VITE_TENANT_SLUG=lamelas
